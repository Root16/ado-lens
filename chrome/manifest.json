{
  "manifest_version": 3,
  "name": "ADO Lens",
  "version": "0.0.4",
  "description": "A compact pull-request summary for Azure DevOps.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "ADO Lens settings",
    "default_popup": "settings.html"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": [
        "src/lib.js",
        "src/ado-api.js",
        "src/stats.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
